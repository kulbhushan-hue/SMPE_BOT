//SMPELOAD JOB (ACCT),'SMPE LOAD PRACTICE JCL',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//* LOADS ALL PRACTICE MEMBERS INTO SMPE.PRAC.JCL (SUBMIT ONCE)
//ALLOC    EXEC PGM=IEFBR14
//JCL      DD DSN=SMPE.PRAC.JCL,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            SPACE=(CYL,(2,1,30)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//LOAD     EXEC PGM=IEBUPDTE,PARM=NEW
//SYSPRINT DD SYSOUT=*
//SYSUT2   DD DSN=SMPE.PRAC.JCL,DISP=OLD
//SYSIN    DD DATA,DLM=##
./ ADD NAME=SMPEPRC
//SMPEPRC  PROC
//* CATALOGED PROC USED BY ALL GIMSMP PRACTICE JOBS
//SMPE     EXEC PGM=GIMSMP,PARM='DATE=U',REGION=0M
//SMPCSI   DD DISP=SHR,DSN=SMPE.PRAC.GLOBAL.CSI
//SMPOUT   DD SYSOUT=*
//SMPRPT   DD SYSOUT=*
//SMPLIST  DD SYSOUT=*
//SMPSNAP  DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SMPHOLD  DD DUMMY
//SYSUT1   DD UNIT=SYSALLDA,SPACE=(CYL,(5,2))
//SYSUT2   DD UNIT=SYSALLDA,SPACE=(CYL,(5,2))
//SYSUT3   DD UNIT=SYSALLDA,SPACE=(CYL,(5,2))
//SYSUT4   DD UNIT=SYSALLDA,SPACE=(CYL,(5,2))
//SMPWRK1  DD UNIT=SYSALLDA,SPACE=(CYL,(5,2,50)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SMPWRK2  DD UNIT=SYSALLDA,SPACE=(CYL,(5,2,50)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SMPWRK3  DD UNIT=SYSALLDA,SPACE=(CYL,(5,2,50)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SMPWRK4  DD UNIT=SYSALLDA,SPACE=(CYL,(5,2,50)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//SMPWRK6  DD UNIT=SYSALLDA,SPACE=(CYL,(5,2,50)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=3120)
//         PEND
./ ADD NAME=J01ALLOC
//J01ALLOC JOB (ACCT),'SMPE ALLOCATE LIBS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//* CHANGE VOL TO A VOLUME WITH 100+ FREE CYLINDERS
//         SET VOL=USER00
//ALLOC    EXEC PGM=IEFBR14
//SMPPTS   DD DSN=SMPE.PRAC.SMPPTS,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(CYL,(5,2,50)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//SMPSCDS  DD DSN=SMPE.PRAC.SMPSCDS,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(CYL,(5,2,50)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//SMPMTS   DD DSN=SMPE.PRAC.SMPMTS,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(CYL,(5,2,50)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//SMPSTS   DD DSN=SMPE.PRAC.SMPSTS,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(CYL,(5,2,50)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//SDUMMYL  DD DSN=SMPE.PRAC.SDUMMYL,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(CYL,(5,2,50)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//ADUMMYL  DD DSN=SMPE.PRAC.ADUMMYL,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(CYL,(5,2,50)),
//            DCB=(DSORG=PO,RECFM=FB,LRECL=80,BLKSIZE=27920)
//SMPLOG   DD DSN=SMPE.PRAC.SMPLOG,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(CYL,(5,2)),
//            DCB=(DSORG=PS,RECFM=VB,LRECL=260,BLKSIZE=27998)
//SMPLOGA  DD DSN=SMPE.PRAC.SMPLOGA,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(CYL,(5,2)),
//            DCB=(DSORG=PS,RECFM=VB,LRECL=260,BLKSIZE=27998)
./ ADD NAME=J02CSI
//J02CSI   JOB (ACCT),'SMPE DEFINE CSIS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//* CHANGE VOLUMES(USER00) TO YOUR VOLUME
//DEFCSI   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DEFINE CLUSTER (NAME(SMPE.PRAC.GLOBAL.CSI) -
   FREESPACE(10 5) KEYS(24 0) RECORDSIZE(24 143) -
   SHAREOPTIONS(2 3) VOLUMES(USER00) CYLINDERS(5 5)) -
   DATA (NAME(SMPE.PRAC.GLOBAL.CSI.DATA) CONTROLINTERVALSIZE(4096)) -
   INDEX (NAME(SMPE.PRAC.GLOBAL.CSI.INDEX) CONTROLINTERVALSIZE(2048))
 DEFINE CLUSTER (NAME(SMPE.PRAC.MVST.CSI) -
   FREESPACE(10 5) KEYS(24 0) RECORDSIZE(24 143) -
   SHAREOPTIONS(2 3) VOLUMES(USER00) CYLINDERS(5 5)) -
   DATA (NAME(SMPE.PRAC.MVST.CSI.DATA) CONTROLINTERVALSIZE(4096)) -
   INDEX (NAME(SMPE.PRAC.MVST.CSI.INDEX) CONTROLINTERVALSIZE(2048))
 DEFINE CLUSTER (NAME(SMPE.PRAC.MVSD.CSI) -
   FREESPACE(10 5) KEYS(24 0) RECORDSIZE(24 143) -
   SHAREOPTIONS(2 3) VOLUMES(USER00) CYLINDERS(5 5)) -
   DATA (NAME(SMPE.PRAC.MVSD.CSI.DATA) CONTROLINTERVALSIZE(4096)) -
   INDEX (NAME(SMPE.PRAC.MVSD.CSI.INDEX) CONTROLINTERVALSIZE(2048))
/*
./ ADD NAME=J03ZONES
//J03ZONES JOB (ACCT),'SMPE DEFINE ZONES',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(GLOBAL) .
 UCLIN .
   ADD OPTIONS(GOPT) PAGELEN(60) .
   ADD GLOBALZONE SREL(Z038) OPTIONS(GOPT)
       ZONEINDEX((MVST,SMPE.PRAC.MVST.CSI,TARGET),
                 (MVSD,SMPE.PRAC.MVSD.CSI,DLIB)) .
   ADD DDDEF(SMPPTS) DA(SMPE.PRAC.SMPPTS) SHR .
   ADD DDDEF(SMPLOG) DA(SMPE.PRAC.SMPLOG) MOD .
 ENDUCL .
 SET BDY(MVST) .
 UCLIN .
   ADD OPTIONS(TOPT) PAGELEN(60) .
   ADD TARGETZONE(MVST) SREL(Z038) OPTIONS(TOPT) RELATED(MVSD) .
   ADD DDDEF(SMPLOGA) DA(SMPE.PRAC.SMPLOGA) MOD .
   ADD DDDEF(SMPSCDS) DA(SMPE.PRAC.SMPSCDS) SHR .
   ADD DDDEF(SMPMTS) DA(SMPE.PRAC.SMPMTS) SHR .
   ADD DDDEF(SMPSTS) DA(SMPE.PRAC.SMPSTS) SHR .
   ADD DDDEF(SDUMMYL) DA(SMPE.PRAC.SDUMMYL) SHR .
 ENDUCL .
 SET BDY(MVSD) .
 UCLIN .
   ADD OPTIONS(DOPT) PAGELEN(60) .
   ADD DLIBZONE(MVSD) SREL(Z038) OPTIONS(DOPT) RELATED(MVST) .
   ADD DDDEF(SMPLOGA) DA(SMPE.PRAC.SMPLOGA) MOD .
   ADD DDDEF(ADUMMYL) DA(SMPE.PRAC.ADUMMYL) SHR .
 ENDUCL .
/*
./ ADD NAME=J04USRMD
//J04USRMD JOB (ACCT),'SMPE CREATE USERMODS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//* CREATES TWO SEQUENTIAL DATASETS HOLDING THE DUMMY USERMODS
//         SET VOL=USER00
//ALLOC    EXEC PGM=IEFBR14
//U1       DD DSN=SMPE.PRAC.USR0001,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//U2       DD DSN=SMPE.PRAC.USR0002,DISP=(NEW,CATLG),UNIT=SYSALLDA,
//            VOL=SER=&VOL,SPACE=(TRK,(1,1)),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//GEN1     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=SMPE.PRAC.USR0001,DISP=OLD
//SYSUT1   DD DATA,DLM=@@
++USERMOD(USR0001) .
++VER(Z038) .
++SAMP(DUMMYJ1) DISTLIB(ADUMMYL) SYSLIB(SDUMMYL) .
//DUMMYJ1  JOB (ACCT),'DUMMY SMPE',CLASS=A,MSGCLASS=X
//* SAMPLE ADDED BY DUMMY USERMOD USR0001 - DOES NOTHING
//STEP1    EXEC PGM=IEFBR14
@@
//GEN2     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT2   DD DSN=SMPE.PRAC.USR0002,DISP=OLD
//SYSUT1   DD DATA,DLM=@@
++USERMOD(USR0002) .
++VER(Z038) PRE(USR0001) .
++SAMP(DUMMYJ2) DISTLIB(ADUMMYL) SYSLIB(SDUMMYL) .
//DUMMYJ2  JOB (ACCT),'DUMMY SMPE',CLASS=A,MSGCLASS=X
//* SAMPLE ADDED BY DUMMY USERMOD USR0002 - DOES NOTHING
//STEP1    EXEC PGM=IEFBR14
@@
./ ADD NAME=J05RECV1
//J05RECV1 JOB (ACCT),'SMPE RECEIVE USR0001',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPPTFIN DD DISP=SHR,DSN=SMPE.PRAC.USR0001
//SMPE.SMPCNTL DD *
 SET BDY(GLOBAL) .
 RECEIVE S(USR0001) .
/*
./ ADD NAME=J06RECV2
//J06RECV2 JOB (ACCT),'SMPE RECEIVE USR0002',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPPTFIN DD DISP=SHR,DSN=SMPE.PRAC.USR0002
//SMPE.SMPCNTL DD *
 SET BDY(GLOBAL) .
 RECEIVE S(USR0002) .
/*
./ ADD NAME=J07LIST
//J07LIST  JOB (ACCT),'SMPE LIST ZONES',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(GLOBAL) .
 LIST SYSMODS .
 LIST DDDEF .
 SET BDY(MVST) .
 LIST SYSMODS .
 SET BDY(MVSD) .
 LIST SYSMODS .
/*
./ ADD NAME=J08PRECK
//J08PRECK JOB (ACCT),'SMPE PREREQ TEST',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//* EXPECT A NON-ZERO RC: USR0002 NEEDS USR0001 (PRE)
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVST) .
 APPLY S(USR0002) CHECK .
/*
./ ADD NAME=J09APCK1
//J09APCK1 JOB (ACCT),'SMPE APPLY CHECK 1',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVST) .
 APPLY S(USR0001) CHECK .
/*
./ ADD NAME=J10APPLY1
//J10APPLY1 JOB (ACCT),'SMPE APPLY USR0001',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVST) .
 APPLY S(USR0001) .
/*
./ ADD NAME=J11APPLY2
//J11APPLY2 JOB (ACCT),'SMPE APPLY USR0002',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVST) .
 APPLY S(USR0002) .
/*
./ ADD NAME=J12RESTR
//J12RESTR JOB (ACCT),'SMPE RESTORE USR0002',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//* BACK USR0002 OUT OF THE TARGET LIBRARY (NOT ALLOWED AFTER ACCEPT)
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVST) .
 RESTORE S(USR0002) .
/*
./ ADD NAME=J13REJCT
//J13REJCT JOB (ACCT),'SMPE REJECT USR0002',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//* REMOVE USR0002 FROM THE GLOBAL ZONE / SMPPTS
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(GLOBAL) .
 REJECT S(USR0002) .
/*
./ ADD NAME=J14ACCK1
//J14ACCK1 JOB (ACCT),'SMPE ACCEPT CHECK',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVSD) .
 ACCEPT S(USR0001) CHECK .
/*
./ ADD NAME=J15ACPT1
//J15ACPT1 JOB (ACCT),'SMPE ACCEPT USR0001',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVSD) .
 ACCEPT S(USR0001) .
/*
./ ADD NAME=J16REPRT
//J16REPRT JOB (ACCT),'SMPE REPORTS',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVST) .
 REPORT ERRSYSMODS .
 REPORT SYSMODS .
 LIST SYSMODS .
/*
./ ADD NAME=J17UCLIN
//J17UCLIN JOB (ACCT),'SMPE UCLIN PRACTICE',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//         JCLLIB ORDER=SMPE.PRAC.JCL
//RUN      EXEC SMPEPRC
//SMPE.SMPCNTL DD *
 SET BDY(MVST) .
 UCLIN .
   ADD DDDEF(SMPTLIB) DA(SMPE.PRAC.SMPTLIB) SHR .
 ENDUCL .
 LIST DDDEF .
 UCLIN .
   DEL DDDEF(SMPTLIB) .
 ENDUCL .
 LIST DDDEF .
/*
./ ADD NAME=J18CLEAN
//J18CLEAN JOB (ACCT),'SMPE CLEANUP',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//* DELETES THE WHOLE SANDBOX SO YOU CAN START AGAIN
//DEL      EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
 DELETE SMPE.PRAC.GLOBAL.CSI CLUSTER PURGE
 DELETE SMPE.PRAC.MVST.CSI CLUSTER PURGE
 DELETE SMPE.PRAC.MVSD.CSI CLUSTER PURGE
 DELETE SMPE.PRAC.SMPPTS PURGE
 DELETE SMPE.PRAC.SMPSCDS PURGE
 DELETE SMPE.PRAC.SMPMTS PURGE
 DELETE SMPE.PRAC.SMPSTS PURGE
 DELETE SMPE.PRAC.SDUMMYL PURGE
 DELETE SMPE.PRAC.ADUMMYL PURGE
 DELETE SMPE.PRAC.SMPLOG PURGE
 DELETE SMPE.PRAC.SMPLOGA PURGE
 DELETE SMPE.PRAC.USR0001 PURGE
 DELETE SMPE.PRAC.USR0002 PURGE
 SET MAXCC=0
/*
##
